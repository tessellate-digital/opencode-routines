# LLM Provider API Keys (configure at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# Default model for new routines (provider/model format)
OPENCODE_MODEL=anthropic/claude-sonnet-4-5

# Optional: protect the web UI with a bearer token
# ADMIN_TOKEN=change-me-to-a-secret

# Max concurrent runs (default: 5)
# MAX_CONCURRENT_RUNS=5
