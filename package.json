{
  "name": "opencode-routines",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "host-agent"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:all": "npm run build && npm run build:frontend",
    "start": "npm run start -w backend",
    "agent": "npm run start -w host-agent",
    "up": "./start.sh",
    "test": "vitest run",
    "prettier": "npx prettier . --write",
    "eslint": "npx eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.4"
  }
}
